export RESTIC_REPOSITORY="{{ item.repository_url }}"
export RESTIC_PASSWORD="{{ item.repository_password }}"

{% if backup_docker_mariadb is defined %}
# MariaDB password for backup
export DB_PASSWORD="{{ backup_docker_mariadb.password }}"
{% endif %}

{% for key, value in (item.env | default({})).items() %}
export {{ key }}="{{ value }}"
{% endfor %}
